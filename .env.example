# --- Django ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=*
# Production'da: CORS_ALLOW_ALL=False va CORS_ALLOWED_ORIGINS=https://sizning-domen.uz
CORS_ALLOW_ALL=True
CORS_ALLOWED_ORIGINS=

# --- PostgreSQL (hozir SQLite; Postgres uchun POSTGRES_DB oldidagi # ni olib tashlang) ---
# POSTGRES_DB=taskflow
POSTGRES_USER=taskflow
POSTGRES_PASSWORD=taskflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Celery / Redis ---
REDIS_URL=redis://localhost:6379/0
# true bo'lsa Redis/worker kerak emas (task darhol, shu jarayonda bajariladi)
CELERY_EAGER=True

# --- Ixtiyoriy: Telegram bot (barcha bildirishnomalar bitta chatga boradi) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ixtiyoriy: Email ---
EMAIL_NOTIFICATIONS=False
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@taskflow.local
